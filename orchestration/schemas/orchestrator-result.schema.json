{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "needsUserInput", "consultation", "tasks"],
  "properties": {
    "reply": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "needsUserInput": { "type": "boolean" },
    "consultation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "questions"],
          "properties": {
            "kind": { "enum": ["technical", "progress_review"] },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "questions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "minItems": 1,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "tasks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "objective",
          "nonGoals",
          "todoPath",
          "writeScopes",
          "checks",
          "dependsOn"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "objective": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "nonGoals": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
          "todoPath": {
            "type": "array",
            "description": "Planning hierarchy below the project root, for example [Stage 1, Selection spike]",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 },
            "maxItems": 8
          },
          "writeScopes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 30
          },
          "checks": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 20
          },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
        }
      }
    }
  }
}
